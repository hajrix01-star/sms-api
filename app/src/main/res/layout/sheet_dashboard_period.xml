<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختيار الفترة المالية"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetDashboardPeriodLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="5dp"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriodAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="كل السجل" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriodToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="اليوم" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriodYesterday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="أمس" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriodThisMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="هذا الشهر" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriodLastMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="الشهر الماضي" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriod7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="7 أيام" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetDashboardPeriod30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="30 يوم" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اختيار مخصص"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetDashboardSingleDay"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="يوم محدد"
                android:textColor="@color/text_accent"
                app:backgroundTint="@color/surface_accent"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetDashboardDateRange"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="من تاريخ إلى تاريخ"
                android:textColor="@color/text_accent"
                app:backgroundTint="@color/surface_accent"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SMS API" android:textSize="30sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_subtitle" android:layout_marginTop="4dp" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="غير مفعّل" android:textStyle="bold" android:padding="16dp" android:layout_marginTop="20dp" android:background="#E6F4EA" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مرسلو البنوك" android:textStyle="bold" android:layout_marginTop="20dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="أضف اسم المرسل كما يظهر في SMS، مثل ALAHLI أو ALRAJHI." />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <EditText android:id="@+id/senderInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="اسم المرسل" />
   <Button android:id="@+id/addSender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إضافة" />
  </LinearLayout>
  <com.google.android.material.chip.ChipGroup android:id="@+id/senderChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="رابط Baseer API" android:textStyle="bold" android:layout_marginTop="20dp" />
  <EditText android:id="@+id/apiUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://baseer.example.com/api/v1/bank-sms" android:inputType="textUri" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مفتاح ربط الجهاز" android:textStyle="bold" android:layout_marginTop="12dp" />
  <EditText android:id="@+id/apiToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="يصدر من بصير" android:inputType="textPassword" />
  <Button android:id="@+id/enable" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حفظ وتفعيل" android:layout_marginTop="24dp" />
  <Button android:id="@+id/test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إرسال رسالة اختبار" />
  <Button android:id="@+id/disable" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إيقاف التحويل" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا يقرأ التطبيق سجل الرسائل القديم ولا يفتح واتساب. رسائل رموز التحقق مستبعدة." android:layout_marginTop="16dp" />
 </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111018"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="SMS API"
            android:textColor="#F4EFF4"
            android:textDirection="ltr"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_subtitle"
            android:textColor="#CFC7D2"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#173A2E"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#29634E"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="الحالة: إذن SMS مطلوب للاختبار"
                android:textColor="#E4F5EA"
                android:textSize="17sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="مرسلو الاختبار"
            android:textColor="#F4EFF4"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="للبنوك: اكتب الاسم كما يظهر في SMS. للأشخاص: اكتب آخر 6–8 أرقام من الرقم، وليس اسم جهة الاتصال."
            android:textColor="#CFC7D2"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="اسم أو رقم المرسل"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#68B497"
                app:hintTextColor="#CFC7D2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/senderInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#F4EFF4"
                    android:textColorHint="#89818D" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSender"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:text="إضافة"
                android:textColor="#FFFFFF"
                app:backgroundTint="#16805D"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/senderChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickSenders"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="اختيار مرسلين من رسائل الجهاز"
            android:textColor="#DDF7EA"
            app:backgroundTint="#244A3C"
            app:cornerRadius="16dp"
            app:strokeColor="#68B497"
            app:strokeWidth="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#1D1B24"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#3A3540"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضع الاختبار المحلي"
                    android:textColor="#F4EFF4"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="لا يوجد API ولا اتصال إنترنت في هذه النسخة. تستقبل فقط الرسائل الجديدة المطابقة وتعرضها على هذا الجوال."
                    android:textColor="#CFC7D2"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enable"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="تفعيل استقبال SMS للاختبار"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#16805D"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="استيراد الرسائل السابقة"
            android:textColor="#F4EFF4"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="يقرأ فقط الرسائل المطابقة للمرسلين أعلاه، حتى نهاية التاريخ الذي تحدده."
            android:textColor="#CFC7D2"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="اختر تاريخ النهاية من التقويم"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#68B497"
            app:hintTextColor="#CFC7D2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/importUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:textColor="#F4EFF4"
                android:textColorHint="#89818D"
                android:textDirection="ltr" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="استيراد الرسائل المطابقة"
            android:textColor="#DDF7EA"
            app:backgroundTint="#244A3C"
            app:cornerRadius="16dp"
            app:strokeColor="#68B497"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/importResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#CFC7D2"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="إضافة حدث اختبار محلي"
            android:textColor="#DDF7EA"
            app:backgroundTint="#244A3C"
            app:cornerRadius="16dp"
            app:strokeColor="#68B497"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disable"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="إيقاف الاستقبال"
            android:textColor="#F6D9DB"
            app:backgroundTint="#392426"
            app:cornerRadius="16dp"
            app:strokeColor="#8D5157"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="سجل الاستلام"
                android:textColor="#F4EFF4"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearHistory"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="مسح السجل"
                android:textColor="#CFC7D2"
                app:backgroundTint="#27232D"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/receiptHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:textColor="#E4DEE7"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="4dp"
            android:text="يحفظ التطبيق آخر 200 سجل على هذا الجوال فقط. محتوى رموز التحقق يُخفى تلقائيًا. الاستيراد يحتاج إذن قراءة SMS ويعمل يدويًا فقط."
            android:textColor="#B8B0BC"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

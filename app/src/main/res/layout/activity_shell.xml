<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/shellRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@color/surface"
            android:contentDescription="فتح القائمة"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/text_accent"
            app:subtitle="السجل المالي المحلي"
            app:subtitleTextColor="@color/text_secondary"
            app:title="الرئيسية"
            app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView android:id="@+id/dashboardPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="السجل البنكي" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/dashboardStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:text="نظرة سريعة" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:id="@+id/dashboardSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_accent" android:textSize="17sp" android:lineSpacingExtra="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/success_container" app:cardCornerRadius="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مراجعة آمنة" android:textColor="@color/text_on_success" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="لا تُهمل الرسائل غير الواضحة: تظهر هنا عندما لا يتعرف التطبيق على النوع المالي أو لا يستطيع ربطها بحساب/شركة." android:textColor="@color/text_on_success" android:textSize="14sp" android:lineSpacingExtra="5dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openReviewQueue" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="مراجعة الرسائل" android:textColor="@color/text_on_success" app:backgroundTint="@color/surface" app:cornerRadius="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="عهدة أسامة — مندوب المشتريات" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="تغذية العهدة من أرز والمعلم الشامي، ومشتريات وسحب بطاقة 0187." android:textColor="@color/text_secondary" android:textSize="14sp" />
                        <TextView android:id="@+id/custodySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_accent" android:textSize="16sp" android:lineSpacingExtra="7dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/operationsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="العمليات"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/operationsFilterSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/operationPeriodChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/periodAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:checkable="true" android:text="كل المدة" />
                <com.google.android.material.chip.Chip android:id="@+id/period7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="آخر 7 أيام" />
                <com.google.android.material.chip.Chip android:id="@+id/period30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="آخر 30 يوم" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/operationReviewChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="تحتاج مراجعة" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/operationFiltersToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:text="فلاتر"
                    android:textColor="@color/text_accent"
                    app:backgroundTint="@color/surface_accent"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/operationAdvancedFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الجهة أو الحساب"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationCompanyChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="البنك أو المرسل"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationBankChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="نوع العملية"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationCategoryChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="ابحث باسم المتجر أو المرجع أو نص الرسالة"
                app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/operationSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/operationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:text="لا توجد عمليات مطابقة. استورد الرسائل أو غيّر الفلاتر."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/operationsRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/accountsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الحسابات والبطاقات" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/accountsOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="الربط المستنتج من عينة الرسائل" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/accountSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="5dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/openAccountManager" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:text="ربط الحسابات والبطاقات المكتشفة" android:textColor="@color/on_primary" app:backgroundTint="@color/primary_action" app:cornerRadius="16dp" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout android:id="@+id/settingsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <include layout="@layout/activity_main" />
        </FrameLayout>
    </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/navigation_header"
        app:itemIconTint="@color/accent"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>

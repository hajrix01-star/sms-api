<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/shellRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/page_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@color/surface"
            android:contentDescription="فتح القائمة"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/text_accent"
            app:subtitle="السجل المالي المحلي"
            app:subtitleTextColor="@color/text_secondary"
            app:title="الرئيسية"
            app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView android:id="@+id/dashboardPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layoutDirection="rtl">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لوحة الأداء المالي" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/dashboardStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_operation_badge" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:textColor="@color/text_accent" android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الفترة المالية" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/dashboardPeriodLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <com.google.android.material.chip.ChipGroup android:id="@+id/dashboardPeriodChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="4dp" app:singleSelection="true">
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriodAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:checkable="true" android:text="كل السجل" />
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriodThisMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="هذا الشهر" />
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriodLastMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="الشهر الماضي" />
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriod7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="7 أيام" />
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriod30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="30 يوم" />
                            <com.google.android.material.chip.Chip android:id="@+id/dashboardPeriodCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="من تاريخ إلى تاريخ" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="الشركات" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="اضغط على أي كرت لعرض العمليات المفصلة ضمن نفس الفترة." android:textColor="@color/text_secondary" android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardArz" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شركة أرز" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="الحساب التشغيلي · مبيعات وسداد وفواتير وعهد" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/arzFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:textColor="@color/text_accent" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardMuallam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شركة المعلم الشامي" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="الحساب الرئيسي والفرعي · تشغيل وسداد وحوالات وعهد" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/muallamFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:textColor="@color/text_accent" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardDoha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مؤسسة دوحة المستهلك التجارية" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="تشغيل إلكتروني · تحويلات وسداد ومدفوعات وتسويات" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/dohaFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:textColor="@color/text_accent" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="تحصيل تطبيقات المعلم الشامي" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="قنوات تحصيل تابعة للمعلم الشامي وليست شركات مستقلة." android:textColor="@color/text_secondary" android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardKeeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/success_container" app:cardCornerRadius="18dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="كيتا" android:textColor="@color/text_on_success" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/keetaFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_on_success" android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardHunger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/success_container" app:cardCornerRadius="18dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="هنقرستيشن" android:textColor="@color/text_on_success" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/hungerFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_on_success" android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardJahez" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/success_container" app:cardCornerRadius="18dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جاهز" android:textColor="@color/text_on_success" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/jahezFlowText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_on_success" android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardOsamaCustody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="عهدة أسامة — مندوب المشتريات" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="تمويل من أرز والمعلم الشامي، ومشتريات وسحب بطاقة 0187." android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/custodySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_accent" android:textSize="15sp" android:lineSpacingExtra="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مركز المراجعة" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="رسائل غير مكتملة الربط أو التصنيف؛ لا تُهمل ولا تُصدّر تلقائيًا." android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openReviewQueue" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:text="فتح قائمة المراجعة" android:textColor="@color/text_accent" app:backgroundTint="@color/surface_accent" app:cornerRadius="14dp" app:strokeColor="@color/accent" app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/operationsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="دفتر العمليات" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/operationsFilterSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فترة العرض" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/operationPeriodChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"
                        app:singleSelection="true">
                        <com.google.android.material.chip.Chip android:id="@+id/periodAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:checkable="true" android:text="كل المدة" />
                        <com.google.android.material.chip.Chip android:id="@+id/periodThisMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="هذا الشهر" />
                        <com.google.android.material.chip.Chip android:id="@+id/periodLastMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="الشهر الماضي" />
                        <com.google.android.material.chip.Chip android:id="@+id/period7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="7 أيام" />
                        <com.google.android.material.chip.Chip android:id="@+id/period30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="30 يوم" />
                    </com.google.android.material.chip.ChipGroup>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <com.google.android.material.chip.Chip android:id="@+id/operationReviewChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="تحتاج مراجعة" />
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/operationFiltersToggle" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="فلاتر" android:textColor="@color/text_accent" app:backgroundTint="@color/surface_accent" app:cornerRadius="12dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/operationReanalyze" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:text="إعادة تحليل" android:textColor="@color/text_accent" app:backgroundTint="@color/surface_accent" app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/operationAdvancedFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_metric_neutral"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الجهة أو الحساب"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationCompanyChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="البنك أو المرسل"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationBankChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="نوع العملية"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/operationCategoryChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="true" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="بحث في المتجر أو المرجع أو نص الرسالة"
                app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/operationSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/operationExportReview"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="تصدير قائمة المراجعة (JSON)"
                android:textColor="@color/text_accent"
                android:textSize="13sp"
                app:backgroundTint="@color/surface_accent"
                app:cornerRadius="12dp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="أحدث الحركات" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/operationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:text="لا توجد عمليات مطابقة. استورد الرسائل أو غيّر الفلاتر."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/operationsRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/accountsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:layoutDirection="rtl">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الحسابات والبطاقات" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="دليل الربط المحلي للشركات والعهد والحسابات الشخصية." android:textColor="@color/text_secondary" android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حالة الدليل المالي" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/accountsOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openAccountManager" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="إدارة الحسابات والبطاقات المكتشفة" android:textColor="@color/on_primary" app:backgroundTint="@color/primary_action" app:cornerRadius="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="الربط المعتمد" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/outline" app:strokeWidth="1dp">
                    <TextView android:id="@+id/accountSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="7dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <FrameLayout android:id="@+id/settingsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <include layout="@layout/activity_main" />
        </FrameLayout>
    </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/navigation_header"
        app:itemIconTint="@color/accent"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>

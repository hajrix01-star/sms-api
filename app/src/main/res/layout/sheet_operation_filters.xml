<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فلترة العمليات" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="اختر ما تريد عرضه ثم اضغط إظهار النتائج." android:textColor="@color/text_secondary" android:textSize="13sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="الفترة" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="5dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/sheetPeriodAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="كل المدة" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetPeriodThisMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="هذا الشهر" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetPeriodLastMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="الشهر الماضي" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetPeriod7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="7 أيام" />
            <com.google.android.material.chip.Chip android:id="@+id/sheetPeriod30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="30 يوم" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.Chip android:id="@+id/sheetReviewChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:checkable="true" android:text="تحتاج مراجعة" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="الجهة أو الحساب" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/sheetCompanyChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="5dp" app:singleSelection="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="البنك أو المرسل" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/sheetBankChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="5dp" app:singleSelection="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="نوع العملية" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/sheetCategoryChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="5dp" app:singleSelection="true" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/sheetClearFilters" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="مسح" android:textColor="@color/text_accent" app:backgroundTint="@color/surface_accent" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sheetApplyFilters" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:layout_weight="2" android:text="إظهار النتائج" app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
